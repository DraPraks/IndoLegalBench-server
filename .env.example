# Salin file ini jadi .env lalu isi nilainya.
# JANGAN pernah commit file .env yang sudah terisi.

APP_ENV=local
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://indolegalbench:indolegalbench@localhost:5432/indolegalbench

# Origin frontend yang boleh mengakses API
CORS_ORIGINS=["http://localhost:3000"]

# Zitadel, diisi saat PBI-1 dikerjakan
ZITADEL_ISSUER=
ZITADEL_CLIENT_ID=
ZITADEL_AUDIENCE=

# Sesi
IDLE_TIMEOUT_MINUTES=30

# Kunci enkripsi kredensial produk AI, dipakai PBI-10.
# Hasilkan dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
